# --- Server ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# --- Database ---
DATABASE_URL="file:./dev.db"

# --- Cache ---
CACHE_DRIVER=memory
# REDIS_URL=redis://localhost:6379

# --- Payments ---
# "mock" boots with zero external config and completes the full 402 -> pay -> 200
# flow in-process. Switch to "algorand-x402" for the real Algorand TestNet flow.
PAYMENT_PROVIDER=mock
ALGORAND_NETWORK=testnet
# X402_FACILITATOR_URL=https://facilitator.goplausible.xyz
# X402_PAY_TO_ADDRESS=YOUR_ALGORAND_TESTNET_ADDRESS
# X402_USDC_ASSET_ID=10458941
# Fee-payer account for the facilitator's fee-sponsored atomic group — read
# it from the `extra.feePayer` field of GET {X402_FACILITATOR_URL}/supported
# for your target network; it may change if the facilitator rotates keys.
# X402_FEE_PAYER_ADDRESS=
# Offers a second, native-ALGO PaymentRequirement alongside the primary
# stablecoin one. Defaults OFF — the live GoPlausible facilitator's `exact`
# scheme rejects a plain native Payment transaction (it requires an ASA
# AssetTransfer). Only turn this on against a facilitator confirmed to
# support native-currency settlement.
# X402_ENABLE_NATIVE_ALGO=false

# --- Global x402 Challenge (Algorand MainNet) ---
# To enter the challenge, deploy with:
#   PAYMENT_PROVIDER=algorand-x402
#   ALGORAND_NETWORK=mainnet
#   X402_FACILITATOR_URL=https://facilitator.goplausible.xyz
#   X402_USDC_ASSET_ID=31566704        # MainNet USDC ASA (TestNet is 10458941)
#   X402_PAY_TO_ADDRESS=<your permanent MainNet address, opted in to ASA 31566704>
#   X402_FEE_PAYER_ADDRESS=<extra.feePayer from GET {facilitator}/supported for MainNet>
# Attribution tag — stamped into every requirement's extra.tag. Settlements
# without it are filed under dev/direct/bazaar and don't count on the
# leaderboard. Use exactly this value for the challenge:
# X402_CHALLENGE_TAG=x402-global-challenge
# Emit Bazaar discovery metadata so the endpoint is cataloged after its
# first real MainNet settlement (required to appear in the Bazaar):
# X402_BAZAAR_DISCOVERY=true
# Optional Bazaar listing-card identity (omit X402_MERCHANT_NAME to let the
# facilitator read it from the endpoint domain's OpenGraph / llms.txt /
# agent-card.json instead):
# X402_MERCHANT_NAME=Agent Market
# X402_MERCHANT_WEBSITE=https://your-domain.example
# X402_MERCHANT_LOGO=https://your-domain.example/logo.png
# X402_MERCHANT_CATEGORIES=api,algorand,x402,crypto-intelligence

# --- Rate limits ---
RATE_LIMIT_ANON_PER_MIN=30
RATE_LIMIT_WALLET_PER_MIN=300
DAILY_SPEND_CAP_USD=50

# --- Security ---
# Signs the wallet-verification token issued after a settled payment, so a
# client can't claim the higher wallet rate-limit tier just by sending
# someone else's public Algorand address. Required (non-default) in production.
# Generate with: openssl rand -hex 32
WALLET_TOKEN_SECRET=dev-only-insecure-wallet-token-secret

# Bearer secret for the admin-only endpoints (currently just the manual
# provider security-audit flag). There's no per-admin identity system —
# anyone holding this key can act as admin. Required (non-default) in
# production. Generate with: openssl rand -hex 32
ADMIN_API_KEY=dev-only-insecure-admin-api-key

# --- Optional keyed providers (never required to boot) ---
# NEWS_API_KEY=
