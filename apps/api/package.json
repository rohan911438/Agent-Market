    "@agentmarket/config": "*",
    "@agentmarket/database": "*",
    "@agentmarket/intelligence-engine": "*",
    "@agentmarket/payments": "*",
    "@agentmarket/providers": "*",
    "@agentmarket/secrets": "*",
    "@agentmarket/shared-types": "*",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.1.0",
    "fastify": "^5.2.0",
    "ioredis": "^6.0.0",
    "zod": "^3.24.1"
  }
}
