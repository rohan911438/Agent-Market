{
  "name": "agentmarket",
  "version": "0.1.0",
  "private": true,
  "description": "AgentMarket — x402-native marketplace for premium AI/financial-intelligence APIs on Algorand",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "db:generate": "npm run generate --workspace=@agentmarket/database",
    "db:migrate": "npm run migrate --workspace=@agentmarket/database",
    "db:migrate:deploy": "npm run migrate:deploy --workspace=@agentmarket/database",
    "db:seed": "npm run seed --workspace=@agentmarket/database",
    "bootstrap": "node scripts/bootstrap.mjs",
    "load-test": "node apps/api/scripts/load-test.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "turbo": "^2.10.9",
    "typescript": "^7.0.2",
    "prettier": "^3.4.2",
    "eslint": "^10.8.1",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "typescript-eslint": "^8.66.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "vitest": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.12",
    "algosdk": "^3.6.0",
    "@x402-avm/core": "^2.6.1",
    "@x402-avm/avm": "^2.6.1",
    "autocannon": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@11.13.0"
}
