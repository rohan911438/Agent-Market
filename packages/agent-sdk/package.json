{
  "name": "@agentmarket/agent-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript client for autonomous agents calling AgentMarket's x402-metered APIs — automatic payment, budgets, retries, fallbacks, and usage tracking.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@agentmarket/shared-types": "*",
    "@x402-avm/avm": "^2.6.1",
    "algosdk": "^3.6.0"
  }
}
